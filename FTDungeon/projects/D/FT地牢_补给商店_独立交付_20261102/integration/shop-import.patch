+    public static boolean spawnPointsEnabled(ResourceManager resources, Entry entry) throws Exception {
+        JsonObject item = read(resources, new ResourceLocation("ftdungeonmobs", "dungeon_rooms/image25/" + entry.id().toLowerCase(Locale.ROOT) + ".json"));
+        if (item.has("spawn_points") && (!item.get("spawn_points").isJsonPrimitive()
+                || !item.getAsJsonPrimitive("spawn_points").isBoolean())) {
+            throw new IllegalArgumentException("spawn_points must be a JSON boolean: " + entry.id());
+        }
+        if (item.has("room_type") && (!item.get("room_type").isJsonPrimitive()
+                || !item.getAsJsonPrimitive("room_type").isString())) {
+            throw new IllegalArgumentException("room_type must be a string: " + entry.id());
+        }
+        if (item.has("room_type") && item.get("room_type").getAsString().equals("shop")) {
+            return false;
+        }
+        return !item.has("spawn_points") || item.get("spawn_points").getAsBoolean();
+    }
